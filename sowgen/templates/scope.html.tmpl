<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} ({{ project_id }})</title>
<style>
  body { font-family: Georgia, "Times New Roman", serif; color: #1f2933; max-width: 820px; margin: 2rem auto; padding: 0 1rem; line-height: 1.45; }
  h1 { font-size: 1.7rem; margin-bottom: 0.2rem; }
  h2 { font-size: 1.2rem; border-bottom: 2px solid #1f2933; padding-bottom: 0.2rem; margin-top: 2rem; }
  h3 { font-size: 1.05rem; margin: 1.6rem 0 0.3rem; }
  h4 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: #52606d; margin: 0.8rem 0 0.2rem; }
  ul { margin: 0.2rem 0 0.4rem 1.2rem; padding: 0; }
  .meta { color: #52606d; margin: 0; }
  .flags { background: #fff8e1; border-left: 4px solid #f0b429; padding: 0.1rem 1rem 0.6rem; margin-top: 1.5rem; }
  table { border-collapse: collapse; width: 100%; margin: 0.3rem 0; font-size: 0.95rem; }
  th, td { text-align: left; padding: 0.3rem 0.5rem; border-bottom: 1px solid #cbd2d9; }
  .num { text-align: right; white-space: nowrap; }
  .total td { font-weight: bold; border-top: 2px solid #1f2933; }
  .note { color: #52606d; font-size: 0.9rem; }
  @media print { body { margin: 0; } h3 { break-after: avoid; } }
</style>
</head>
<body>
<h1>{{ title }}</h1>
<p class="meta">Prepared by {{ company }}</p>
<p class="meta">Project {{ project_id }} | Client: {{ client_label }} | Site: {{ site_label }}</p>
{% if prepared_date %}
<p class="meta">Date: {{ prepared_date }}</p>
{% endif %}

<h2>Project summary</h2>
<table>
{% for row in summary %}
  <tr><th scope="row">{{ row.label }}</th><td>{{ row.value }}</td></tr>
{% endfor %}
</table>
{% if review_flags %}

<section class="flags">
<h2>Review before sending</h2>
<ul>
{% for flag in review_flags %}
  <li>{{ flag }}</li>
{% endfor %}
</ul>
</section>
{% endif %}

<h2>Scope by trade</h2>
{% for s in sections %}
<section class="trade">
<h3>{{ s.number }}. {{ s.trade }}</h3>
{% if s.inclusions %}
<h4>Inclusions</h4>
<ul>
{% for line in s.inclusions %}
  <li>{{ line }}</li>
{% endfor %}
</ul>
{% else %}
<p>No work is included under this trade.</p>
{% endif %}
{% if s.exclusions %}
<h4>Exclusions</h4>
<ul>
{% for line in s.exclusions %}
  <li>{{ line }}</li>
{% endfor %}
</ul>
{% endif %}
{% if s.assumptions %}
<h4>Assumptions</h4>
<ul>
{% for line in s.assumptions %}
  <li>{{ line }}</li>
{% endfor %}
</ul>
{% endif %}
{% if s.allowances %}
<h4>Allowances</h4>
<table>
  <tr><th>Item</th><th>Basis</th><th class="num">Allowance</th></tr>
{% for a in s.allowances %}
  <tr><td>{{ a.item }}</td><td>{{ a.basis }}</td><td class="num">{{ a.amount }}</td></tr>
{% endfor %}
</table>
{% endif %}
</section>
{% endfor %}

<h2>General exclusions</h2>
<ul>
{% for line in general_exclusions %}
  <li>{{ line }}</li>
{% endfor %}
</ul>

<h2>General assumptions</h2>
<ul>
{% for line in general_assumptions %}
  <li>{{ line }}</li>
{% endfor %}
</ul>

<h2>Allowance summary</h2>
<table>
  <tr><th>Trade</th><th>Item</th><th class="num">Allowance</th></tr>
{% for a in allowance_rows %}
  <tr><td>{{ a.trade }}</td><td>{{ a.item }}</td><td class="num">{{ a.amount }}</td></tr>
{% endfor %}
  <tr class="total"><td></td><td>Total allowances</td><td class="num">{{ allowance_total }}</td></tr>
</table>
<p class="note">Allowance figures are placeholders for selections not yet made. They are not a price for the project.</p>
</body>
</html>
